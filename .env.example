# API Keys for Experiment Providers
# Copy this file to .env and fill in your keys.

# OpenAI
# OPENAI_API_KEY=sk-...

# Google (Gemini)
# GOOGLE_API_KEY=...

# OpenRouter
# OPENROUTER_API_KEY=sk-or-v1-...

# Anthropic (required for judging)
# ANTHROPIC_API_KEY=sk-ant-...

# Groq
# GROQ_API_KEY=gsk_...
